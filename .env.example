# Auth: Bedrock workload identity (default)
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-west-2
ANTHROPIC_API_KEY_PLACEHOLDER=

# Bedrock model — cross-region inference profile IDs available in us-west-2.
# Uncomment one. Haiku is cheapest/fastest (default for cost-efficient demos).
# Refresh this list / verify access in your account:
#   aws bedrock list-inference-profiles --region us-west-2 \
#     --query "inferenceProfileSummaries[?contains(inferenceProfileId,'anthropic')].inferenceProfileId" --output text
#
# US profiles (us. prefix):
ANTHROPIC_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_MODEL=us.anthropic.claude-3-5-haiku-20241022-v1:0
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-8
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-7
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-6-v1
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-5-20251101-v1:0
# ANTHROPIC_MODEL=us.anthropic.claude-opus-4-1-20250805-v1:0
#
# Global profiles (global. prefix) — also available in us-west-2:
# ANTHROPIC_MODEL=global.anthropic.claude-opus-4-8
# ANTHROPIC_MODEL=global.anthropic.claude-sonnet-4-6
# ANTHROPIC_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Auth: API key (uncomment and set if not using Bedrock)
# CLAUDE_CODE_USE_BEDROCK=
# AWS_REGION=
# ANTHROPIC_API_KEY_PLACEHOLDER=FAKE_KEY_REPLACED_BY_PROXY
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Always required
GH_TOKEN=ghp_REPLACE_ME
TESTING_REPO=OWNER/REPO_NAME

# Cluster setup (used by create-cluster.sh)
# AUTH_MODE=bedrock
# AWS_VAULT_PROFILE=bedrock-claude
